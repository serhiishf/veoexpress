  status = 301
  force = true

[[redirects]]
  from = "https://ru.veoexpress.ee/*"
  to = "https://veoexpress.ee/ru/:splat"
  status = 301
  force = true

[[redirects]]
  from = "http://et.veoexpress.ee/*"
  to = "https://veoexpress.ee/:splat"
  status = 301
  force = true

[[redirects]]
  from = "https://et.veoexpress.ee/*"
  to = "https://veoexpress.ee/:splat"
  status = 301
  force = true
