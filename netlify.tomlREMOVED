[[redirects]]
  from = "http://en.veoexpress.ee/*"
  to = "https://veoexpress.ee/en/:splat"
  status = 301
  force = true

[[redirects]]
  from = "https://en.veoexpress.ee/*"
  to = "https://veoexpress.ee/en/:splat"
  status = 301
  force = true

